.row
    .username
        .avatar
            img(tg-avatar="currentUser", tg-bo-alt="currentUser.full_name_display")

            .avatar-data
                .name
                    span(tg-bo-bind="currentUser.full_name_display")
                    tg-svg(
                        ng-if="currentUser.id == owner"
                        svg-icon="icon-badge"
                        svg-title-translate="COMMON.OWNER"
                    )

                .position(tg-bo-bind="currentUser.role_name")

                div(
                    tg-leave-poker=""
                    project="project"
                    user="currentUser"
                )

                div.select-story(style="margin-top: 1rem; display: block;")

                    //- Selección de sesión (todos los roles)
                    div(style="margin-top: 1rem; display: flex; flex-direction: column; align-items: flex-start; gap: 0.5rem;")

                        select(
                            ng-model="$parent.sessionId"
                            ng-change="$parent.changeSession($parent.sessionId)"
                            ng-options="session.id as (session.name || 'Sesión ' + session.id) for session in sessions"
                            ng-disabled="!sessions || sessions.length === 0"
                            style="padding: 0.5rem; border: 1px solid #ccc; background: white; width: 100%; max-width: 250px;"
                        )
                            option(value="") -- Selecciona una sesión --

                        .export-controls(ng-show="canExport()")
                            button.btn.btn-primary.export-button(
                                ng-click="exportToExcel()"
                                title="Exportar sesión a Excel"
                            )
                                svg.icon
                                    use(href="#icon-download")
                                span.button-text Exportar a Excel

                        div(ng-if="(!sessions || sessions.length === 0) && currentUser.role_name === 'Scrum Master'")
                            p(style="color: gray; font-style: italic; margin: 0;") No hay sesiones activas disponibles.  

                        button(
                            ng-if="currentUser.role_name === 'Scrum Master'"
                            ng-click="$root.$broadcast('genericform:new', { objType: 'planning', project: project })"
                            style="padding: 0.5rem 1rem; background: #2196F3; color: white; border: none; border-radius: 4px; font-weight: bold;"
                        ) Crear nueva sesión

                        p(ng-if="currentUser.role_name !== 'Scrum Master'" style="color: darkred; font-style: italic; margin: 0;")
                            | Solo el Scrum Master puede crear una nueva sesión de Planning Poker.
                    
                    //- Selector de historia (todos los roles)
                    select(
                        ng-model="$parent.selectedStory",
                        ng-options="story as story.subject for story in sessionUserStories track by story.id",
                        ng-show="sessionUserStories && sessionUserStories.length > 0",
                        style="margin-top: 1.5rem; padding: 0.5rem; border: 1px solid #ccc; background: white; display: block;"
                    )
                        option(value="") Selecciona una historia...
                    
                    p(ng-show="!sessionUserStories || sessionUserStories.length === 0", style="color: gray; font-style: italic; margin-top: 1.5rem;")
                        | No hay historias asignadas a esta sesión   

                    //- Mensaje específico para Scrum Master
                    div(ng-if="currentUser.role_name === 'Scrum Master'" style="margin-top: 1rem; padding: 1rem; background: #f5f5f5; border-radius: 4px;")
                        p(style="margin: 0; font-style: italic;")
                            | Como Scrum Master, puedes ver las estimaciones pero no participar en ellas.
                        p(style="margin: 0.5rem 0 0 0;")
                            | Selecciona una historia arriba y luego selecciona la misma en "Story for all team members" para ver las estimaciones del equipo.   

                    //- Mostrar input y botón de estimación SOLO si el rol NO es PO, SM o Stakeholder
                    div(ng-if="currentUser.role_name !== 'Product Owner' && currentUser.role_name !== 'Scrum Master' && currentUser.role_name !== 'Stakeholder'")
                        div(style="margin-top: 1rem;")
                            label(style="display: block; margin-bottom: 0.5rem; font-weight: 500;") 
                                | Selecciona tu estimación (Fibonacci)

                            //- Mostrar si ya votó
                            p(ng-if="$parent.currentEstimations[$parent.selectedStory.id]" style="background: #e8f5e9; padding: 0.5rem; border-radius: 4px; margin-bottom: 0.5rem;")
                                | Ya estimaste esta historia con: 
                                strong {{ $parent.currentEstimations[$parent.selectedStory.id] }} puntos

                            //- Botones de Fibonacci
                            .fibonacci-buttons(style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;")
                                button(
                                    ng-repeat="value in [0, 1, 2, 3, 5, 8, 13, 20, 40, 100]"
                                    ng-click="$parent.setEstimationValue(value)"
                                    ng-class="{'selected': $parent.estimationValue === value}"
                                    style="padding: 0.5rem 1rem; border: 1px solid #ccc; background: white; cursor: pointer; border-radius: 4px; min-width: 50px; transition: all 0.2s;"
                                    ng-style="{'background-color': $parent.estimationValue === value ? '#4CAF50' : 'white', 'color': $parent.estimationValue === value ? 'white' : 'black'}"
                                ) {{ value }}
                            
                            //- Mostrar valor seleccionado
                            p(ng-if="$parent.estimationValue !== null && $parent.estimationValue !== undefined" style="margin: 0.5rem 0;")
                                | Valor seleccionado: 
                                strong {{ $parent.estimationValue }}
                            
                            //- Botón de enviar
                            button(
                                ng-click="$parent.sendEstimation()"
                                ng-disabled="!$parent.selectedStory || $parent.estimationValue === null || $parent.estimationValue === undefined"
                                style="padding: 0.75rem 1.5rem; width: 100%; background-color: #4CAF50; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; transition: opacity 0.2s;"
                                ng-style="{'opacity': (!$parent.selectedStory || $parent.estimationValue === null) ? '0.5' : '1', 'cursor': (!$parent.selectedStory || $parent.estimationValue === null) ? 'not-allowed' : 'pointer'}"
                            ) 
                                span(ng-if="!$parent.currentEstimations[$parent.selectedStory.id]") Enviar estimación
                                span(ng-if="$parent.currentEstimations[$parent.selectedStory.id]") Actualizar estimación

                    //- Mensaje para roles sin permisos
                    p(ng-if="currentUser.role_name === 'Product Owner' || currentUser.role_name === 'Scrum Master' || currentUser.role_name === 'Stakeholder'" style="margin-top: 1rem; font-style: italic; color: gray;")
                        | Tu rol ({{ currentUser.role_name }}) solo puede visualizar las estimaciones.
                
    // Columna Story
    .attribute.attribute-name
        span(ng-if="!$parent.selectedStory")
            tg-svg(
                svg-icon="icon-briefcase",
                svg-title-translate="PLANNING_POKER.COLUMN_STORY"
            )
        span(ng-if="$parent.selectedStory" style="display: block; text-align: center; margin-left: 1rem; font-weight: bold;") 
            | {{$parent.selectedStory.subject || ('Historia ' + $parent.selectedStory.id)}}

    // Columna Estimation
    .attribute
        span(ng-if="!$parent.selectedStory || !$parent.currentEstimations[$parent.selectedStory.id]")
            tg-svg(
                svg-icon="icon-iocaine",
                svg-title-translate="PLANNING_POKER.COLUMN_ESTIMATION"
            )
        span(
            ng-if="$parent.selectedStory && $parent.currentEstimations[$parent.selectedStory.id]" 
            style="display: block; text-align: center; margin-left: 1rem; font-weight: bold; font-size: 1.2em; color: #4CAF50;"
        ) {{ $parent.currentEstimations[$parent.selectedStory.id] }}

    // Columna Faltan por votar
    .attribute(style="text-align: center;")
        span(ng-if="$parent.selectedStoryForMembers") {{ $parent.missingVotes || 0 }}
        span(ng-if="!$parent.selectedStoryForMembers") --

    // Columna Consenso
    .attribute(style="text-align: center;")
        span(ng-if="!$parent.allVoted") --
        span(ng-if="$parent.allVoted && !$parent.hasConsensus" style="color: #FF9800; font-weight: bold; font-size: 1.2em;") ⚠️
        span(ng-if="$parent.hasConsensus" style="color: #4CAF50; font-weight: bold;") ✓

    // Columna Estimación Final
    .attribute(style="text-align: center;")
        span(ng-if="!$parent.hasConsensus") --
        span(ng-if="$parent.hasConsensus" style="font-weight: bold; color: #4CAF50;") {{ $parent.consensusValue }}

    // Columna Historia Estimada
    .attribute(style="text-align: center;")
        span(ng-if="!$parent.hasConsensus") ❌
        span(ng-if="$parent.hasConsensus" style="color: #4CAF50;") ✅

div.lightbox.lightbox-generic-form.lightbox-create-edit(tg-lb-create-edit)